# Connection string for the ephemeral Postgres started by docker-compose.yml
DATABASE_URL="postgresql://careshield:careshield@localhost:5433/careshield?schema=public"

# Port the NestJS API listens on
PORT=4000

# Comma separated list of origins allowed to call the API
CORS_ORIGINS="http://localhost:3000"

# Enables the tok_fail_issue_* / tok_decline_* sandbox tokens. Never set this
# in production - it can fail policy issuance after the money has moved.
ALLOW_PAYMENT_FAULT_INJECTION=true
